{
  "manifest_version": 3,
  "name": "Agenda MQL - AutoLogin SUNAT & Buzone Session Isolation",
  "version": "1.2.0",
  "description": "Aislamiento de sesiones múltiples y auto-login RPA en portales de SUNAT Clave SOL y SUNAFIL para clientes de Agenda MQL",
  "icons": {
    "48": "icon48.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "*://*.sunat.gob.pe/*",
    "*://*.sunafil.gob.pe/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.github.io/*",
        "https://*.onrender.com/*",
        "http://192.168.*/*"
      ],
      "js": ["content_mql.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.sunat.gob.pe/*",
        "*://*.sunafil.gob.pe/*"
      ],
      "js": ["content_sunat.js"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ]
}
