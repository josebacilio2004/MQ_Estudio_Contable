# Puerto del servidor backend
PORT=4100

# Conexión a Base de Datos Supabase (PostgreSQL con SSL)
DATABASE_URL=postgresql://postgres:[TU_PASSWORD]@db.[TU_PROYECTO].supabase.co:5432/postgres

